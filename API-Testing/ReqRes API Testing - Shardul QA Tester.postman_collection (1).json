	"item": [
		{
			"name": "GET Users - Page 2",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const responseJson = pm.response.json();",
							"",
							"pm.test('Response contains page = 2', function() {",
							"    pm.expect(responseJson.page).to.eql(2);",
							"});",
							"",
							"pm.test('Response contains data array', function() {",
							"    pm.expect(responseJson.data).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://reqres.in/api/users?page=2",
					"protocol": "https",
					"host": [
						"reqres",
						"in"
					],
					"path": [
						"api",
						"users"
					],
					"query": [
						{
							"key": "page",
							"value": "2"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "POST Create User - Shardul QA Tester",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"const responseJson = pm.response.json();",
							"",
							"pm.test('Response has id', function() {",
							"    pm.expect(responseJson).to.have.property('id');",
							"});",
							"",
							"pm.test('Response has createdAt', function() {",
							"    pm.expect(responseJson).to.have.property('createdAt');",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
